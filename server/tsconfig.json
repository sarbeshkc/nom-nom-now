{
  "compilerOptions": {
    "target": "ES2022",               // Updated target
    "module": "NodeNext",             // Updated module
    "lib": ["ES2022"],               // Updated lib
    "moduleResolution": "NodeNext",   // Added moduleResolution
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["node_modules"]
}